# ============================================================
# Docifer local environment template
# Copy this file to .env and fill in real values.
# ============================================================

# -----------------------------
# App
# -----------------------------
APP_NAME=Docifer
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# -----------------------------
# PostgreSQL
# -----------------------------
POSTGRES_DB=docifer
POSTGRES_USER=docifer_user
POSTGRES_PASSWORD=docifer_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://docifer_user:docifer_password@localhost:5432/docifer

# -----------------------------
# Qdrant
# -----------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_TEXT_COLLECTION=docifer_text_chunks

# -----------------------------
# Model provider switch
# -----------------------------
LLM_PROVIDER=openai

# -----------------------------
# OpenAI - development mode
# -----------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5.4-mini

# -----------------------------
# Vertex AI - portfolio/demo mode
# -----------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_DEFAULT_MODEL=
VERTEX_FALLBACK_MODEL=

# -----------------------------
# LangSmith
# -----------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docifer-dev

# -----------------------------
# Local storage paths
# -----------------------------
RAW_PDF_DIR=datasets/raw_pdfs
PROCESSED_DATA_DIR=datasets/processed
ARTIFACTS_DIR=artifacts
GOLDEN_EVAL_PATH=docifer_phase1_corpus_and_golden_eval_v1.xlsx
EVAL_RUNS_DIR=evals/runs
