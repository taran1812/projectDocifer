# ============================================================
# Docifer local environment template
# Copy this file to .env and fill in real values.
# ============================================================

# -----------------------------
# App
# -----------------------------
APP_NAME=Docifer
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a strong random value to enable API key auth. Leave blank to disable (dev only).
DOCIFER_API_KEY=

# -----------------------------
# PostgreSQL
# -----------------------------
POSTGRES_DB=docifer
POSTGRES_USER=docifer_user
POSTGRES_PASSWORD=docifer_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://docifer_user:docifer_password@localhost:5432/docifer

# -----------------------------
# Qdrant
# -----------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_TEXT_COLLECTION=docifer_text_chunks
QDRANT_TABLE_COLLECTION=docifer_table_evidence
QDRANT_VISUAL_COLLECTION=docifer_visual_evidence
QDRANT_EXACT_SEARCH=false
QDRANT_SEARCH_EF=64
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_CREATE_PAYLOAD_INDEXES=true

# -----------------------------
# Text reranker
# -----------------------------
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_TOP_N=20
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

# -----------------------------
# Model provider switch
# -----------------------------
LLM_PROVIDER=openai

# -----------------------------
# OpenAI - development mode
# -----------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_ANSWER_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# -----------------------------
# Vertex AI - portfolio/demo mode
# -----------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_DEFAULT_MODEL=
VERTEX_FALLBACK_MODEL=

# -----------------------------
# LangSmith
# -----------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docifer-dev

# -----------------------------
# Local storage paths
# -----------------------------
RAW_PDF_DIR=datasets/raw_pdfs
PROCESSED_DATA_DIR=datasets/processed
ARTIFACTS_DIR=artifacts
DOCLING_MAX_FILE_SIZE_BYTES=500000000
UPLOAD_MAX_FILE_SIZE_BYTES=1000000000
GOLDEN_EVAL_PATH=docifer_phase1_corpus_and_golden_eval_v1.xlsx
EVAL_RUNS_DIR=evals/runs

# Text chunking
TEXT_CHUNK_SIZE=1200
TEXT_CHUNK_OVERLAP=200
